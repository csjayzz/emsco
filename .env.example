# ───────────────────────────────────────────────────────
# EMS Frontend — Environment Variables (Vite)
# Copy this file to .env and fill in your real values.
# ───────────────────────────────────────────────────────

# Backend API URL used by the frontend
VITE_API_URL=http://localhost:5000

# Google Maps API Key (restrict to your domain in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Firebase web config for frontend (safe to expose client-side with domain restrictions)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxx
VITE_FIREBASE_VAPID_KEY=YOUR_VAPID_KEY
